<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme aplicado durante el arranque del proceso (antes que Flutter dibuje su primer frame).
         Usamos color sólido verde brand para que NO haya pantalla blanca. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme aplicado mientras la UI de Flutter inicializa y de fondo mientras corre. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
